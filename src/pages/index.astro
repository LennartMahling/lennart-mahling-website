---
import Layout from '../layouts/Layout.astro';

const services = [
	{ number: '01', title: 'Digitale Produkte', text: 'Websites und Anwendungen, die komplexe Ideen in klare, schnelle Erlebnisse übersetzen.' },
	{ number: '02', title: 'Marke im Raum', text: '3D-Visualisierungen und visuelle Systeme mit Charakter, Tiefe und einer eigenen Haltung.' },
	{ number: '03', title: 'Von Idee zu Wirkung', text: 'Konzeption, Design und Entwicklung aus einer Hand – fokussiert auf das, was wirklich zählt.' },
];

const projects = [
	{ type: 'Digital Experience', title: 'Klarheit für komplexe Produkte', className: 'project--violet' },
	{ type: '3D & Visualization', title: 'Räume, die man spüren kann', className: 'project--lime' },
	{ type: 'Brand & Web', title: 'Ein Auftritt mit Haltung', className: 'project--blue' },
];
---

<Layout title="Lennart Mahling — smarte Software">
	<header class="site-header">
		<div class="container">
			<a class="wordmark" href="#top" aria-label="Zur Startseite">LM<span>•</span></a>
			<nav aria-label="Hauptnavigation">
				<a href="#ueber-mich">Über mich</a>
				<a href="#arbeiten">Arbeiten</a>
				<a href="#leistungen">Leistungen</a>
				<a href="#portfolio">Portfolio</a>
			</nav>
			<a class="header-contact" href="#kontakt">Projekt starten<span aria-hidden="true">↗</span></a>
		</div>
	</header>

	<main id="top">
		<section class="hero container">
			<div class="hero-copy">
				<p class="eyebrow reveal">Unabhängiger 3D Artist und Developer</p>
				<h1 class="reveal reveal--delay">Digitale Erlebnisse<br />
					<em>mit Charakter.</em>
				</h1>
				<div class="hero-bottom reveal reveal--delay-2">
					<p>Ich bin Lennart Mahling. Ich entwickle zugeschnittene, smarte Software und Visualisierungen für Menschen und Marken mit Ambition.</p>
					<a class="round-link" href="#ueber-mich" aria-label="Ausgewählte Arbeiten ansehen">↓</a>
				</div>
			</div>
			<div class="orb orb--one"></div>
			<div class="orb orb--two"></div>
			<div class="hero-grid" aria-hidden="true"></div>
		</section>

		<section class="intro-section container" id="ueber-mich">
			<p class="section-label">Wer und Was</p>
			<div class="intro-copy">
				<p>Gutes Design fühlt sich <span>selbstverständlich</span> an. Dahinter steckt jedoch ein Prozess aus Neugier, Präzision und vielen klugen Entscheidungen.</p>
				<a class="text-link" href="/intro">Mehr über wer ich bin und was ich mache<span>→</span></a>
			</div>
		</section>

		<section class="work-section container" id="arbeiten">
			<div class="section-heading">
				<p class="section-label">Ausgewählte Arbeiten</p>
				<p>Eine Auswahl an Projekten aus Software Solutions und 3D Art.</p>
			</div>
			<div class="project-grid">{projects.map((project, index) => (<a class={`project-card ${project.className}`} href="/projects"><div class="project-art" aria-hidden="true">{index === 0 && <div class="glass-window"><i></i><i></i><i></i></div>}{index === 1 && <div class="lime-sculpture"></div>}{index === 2 && <div class="blue-disc"><span></span></div>}</div><div class="project-meta"><span>{project.type}</span><span>↗</span></div><h3>{project.title}</h3></a>))}</div>
		</section>

		<section class="services-section" id="leistungen">
			<div class="container">
				<div class="section-heading section-heading--light">
					<p class="section-label">Meine Leistungen</p>
					<p>Strategisch denken. Konsequent gestalten. Sorgfältig umsetzen.</p>
				</div>
				<div class="services-list">{services.map((service) => (<article class="service-item"><span>{service.number}</span>
					<h3>{service.title}</h3>
					<p>{service.text}</p>
					<a class="service-arrow" href="#kontakt">↗</a></article>))}
					<a class="text-link" href="/services">Die Leistungen im Detail <span>→</span></a>
				</div>
			</div>
		</section>

		<section class="portfolio-section container" id="portfolio">
			<div class="section-heading">
				<p class="section-label">Werdegang & Expertise</p>
				<p>Kontinuierliche Entwicklung in Technologie, Design und Systemarchitektur.</p>
			</div>

			<div class="portfolio-grid">
				<div class="portfolio-preview-card" aria-hidden="true">
					<div class="portfolio-card-header">
						<div class="window-controls">
							<span></span>
							<span></span>
							<span></span>
						</div>
						<span class="card-tag">SYSTEM_MANIFEST // V2.6</span>
					</div>
					<div class="portfolio-card-body">
						<div class="portfolio-metrics">
							<div class="metric">
								<span class="metric-label">CORE_FIELDS</span>
								<span class="metric-value">SOFTWARE / WEB / 3D</span>
							</div>
							<div class="metric">
								<span class="metric-label">STACK_FOCUS</span>
								<span class="metric-value">MODERN FULLSTACK</span>
							</div>
						</div>
						<div class="code-snippet">
							<span class="code-line"><em>class</em> Developer <span class="code-punct">&#123;</span></span>
							<span class="code-line code-indent">focus <span class="code-punct">=</span> [<span class="code-str">'Clean Architecture'</span>, <span class="code-str">'Realtime 3D'</span>];</span>
							<span class="code-line code-indent">status <span class="code-punct">=</span> <span class="code-str">'Continuously Evolving'</span>;</span>
							<span class="code-line"><span class="code-punct">&#125;</span></span>
						</div>
						<div class="portfolio-badge-row">
							<span class="tech-pill">C# / .NET</span>
							<span class="tech-pill">Astro & Web</span>
							<span class="tech-pill">Shader & 3D Art</span>
							<span class="tech-pill">Linux & Cloud</span>
						</div>
					</div>
				</div>

				<div class="portfolio-copy">
					<h2>Technisches Fundament<br /><em>mitgestalten.</em></h2>
					<p>
						Neben der Arbeit an Kundenprojekten vertiefe ich fortlaufend mein Wissen in zeitgemäßer Softwarearchitektur, Experimenten mit Echtzeit-Graphics und modernen Webtechnologien.
					</p>
					<p class="portfolio-subtext">
						Mein vollständiges Portfolio bietet einen transparenten Einblick in Qualifikationen, Zertifikate, persönliche Entwicklungsprojekte sowie meinen technischen Werdegang.
					</p>
					<a class="text-link portfolio-cta" href="/portfolio">
						Vollständiges Portfolio ansehen <span>→</span>
					</a>
				</div>
			</div>
		</section>

		<section class="contact-section container" id="kontakt">
			<p class="section-label">Lassen Sie uns sprechen</p>
			<h2>Eine gute Idee<br />verdient einen <em>starken Anfang.</em></h2>
			<a class="contact-mail" href="mailto:info@lennart-mahling.de">info@lennart-mahling.de
				<span>↗</span>
			</a>
		</section>
	</main>

	<footer class="site-footer container">
		<div class="footer-legal">
			<span>© {new Date().getFullYear()} Lennart Mahling</span>
			<span class="footer-tax-note">Kleinunternehmer gem. § 19 UStG</span>
		</div>
		<div class="footer-links">
			<a href="/impressum">Impressum</a>
			<a href="/datenschutz">Datenschutz</a>
			<a href="#top">Nach oben ↑</a>
		</div>
	</footer>
</Layout>