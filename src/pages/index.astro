---
import Layout from '../layouts/Layout.astro';

const services = [
	{ number: '01', title: 'Digitale Produkte', text: 'Websites und Anwendungen, die komplexe Ideen in klare, schnelle Erlebnisse übersetzen.' },
	{ number: '02', title: 'Marke im Raum', text: '3D-Visualisierungen und visuelle Systeme mit Charakter, Tiefe und einer eigenen Haltung.' },
	{ number: '03', title: 'Von Idee zu Wirkung', text: 'Konzeption, Design und Entwicklung aus einer Hand – fokussiert auf das, was wirklich zählt.' },
];

const projects = [
	{ type: 'Digital Experience', title: 'Klarheit für komplexe Produkte', className: 'project--violet' },
	{ type: '3D & Visualization', title: 'Räume, die man spüren kann', className: 'project--lime' },
	{ type: 'Brand & Web', title: 'Ein Auftritt mit Haltung', className: 'project--blue' },
];
---

<Layout title="Lennart Mahling — smarte Software">
	<header class="site-header">
		<div class="container">
			<a class="wordmark" href="#top" aria-label="Zur Startseite">LM<span>•</span></a>
			<nav aria-label="Hauptnavigation">
				<a href="#ueber-mich">Über mich</a>
				<a href="#arbeiten">Arbeiten</a>
				<a href="#leistungen">Leistungen</a>
				<a href="#kontakt">Portfolio</a>
			</nav>
			<a class="header-contact" href="#kontakt">Projekt starten<span aria-hidden="true">↗</span></a>
		</div>
	</header>

	<main id="top">
		<section class="hero container">
			<div class="hero-copy">
				<p class="eyebrow reveal">Unabhängiger 3D Artist und Developer</p>
				<h1 class="reveal reveal--delay">Digitale Erlebnisse<br />
					<em>mit Charakter.</em>
				</h1>
				<div class="hero-bottom reveal reveal--delay-2">
					<p>Ich bin Lennart Mahling. Ich entwickle zugeschnittene, smarte Software und Visualisierungen für Menschen und Marken mit Ambition.</p>
					<a class="round-link" href="#arbeiten" aria-label="Ausgewählte Arbeiten ansehen">↓</a>
				</div>
			</div>
			<div class="orb orb--one"></div>
			<div class="orb orb--two"></div>
			<div class="hero-grid" aria-hidden="true"></div>
		</section>

		<section class="intro-section container" id="ueber-mich">
			<p class="section-label">Wer und Was</p>
			<div class="intro-copy">
				<p>Gutes Design fühlt sich <span>selbstverständlich</span> an. Dahinter steckt jedoch ein Prozess aus Neugier, Präzision und vielen klugen Entscheidungen.</p>
				<a class="text-link" href="#kontakt">Mehr über wer ich bin und was ich mache<span>→</span></a>
			</div>
		</section>

		<section class="work-section container" id="arbeiten">
			<div class="section-heading">
				<p class="section-label">Ausgewählte Arbeiten</p>
				<p>Eine Auswahl an Projekten aus Software Solutions und 3D Art.</p>
			</div>
			<div class="project-grid">{projects.map((project, index) => (<a class={`project-card ${project.className}`} href="#kontakt"><div class="project-art" aria-hidden="true">{index === 0 && <div class="glass-window"><i></i><i></i><i></i></div>}{index === 1 && <div class="lime-sculpture"></div>}{index === 2 && <div class="blue-disc"><span></span></div>}</div><div class="project-meta"><span>{project.type}</span><span>↗</span></div><h3>{project.title}</h3></a>))}</div>
		</section>

		<section class="services-section" id="leistungen">
			<div class="container">
				<div class="section-heading section-heading--light">
					<p class="section-label">Meine Leistungen</p>
					<p>Strategisch denken. Konsequent gestalten. Sorgfältig umsetzen.</p>
				</div>
				<div class="services-list">{services.map((service) => (<article class="service-item"><span>{service.number}</span>
					<h3>{service.title}</h3>
					<p>{service.text}</p>
					<a class="service-arrow" href="#kontakt">↗</a></article>))}
					<a class="text-link" href="#kontakt">Die Leistungen im Detail <span>→</span></a>
				</div>
			</div>
		</section>

		<section class="contact-section container" id="kontakt">
			<p class="section-label">Lassen Sie uns sprechen</p>
			<h2>Eine gute Idee<br />verdient einen <em>starken Anfang.</em></h2>
			<a class="contact-mail" href="mailto:hallo@lennartmahling.de">hallo@lennartmahling.de
				<span>↗</span>
			</a>
		</section>
	</main>

	<footer class="site-footer container">
		<span>© {new Date().getFullYear()} Lennart Mahling</span>
		<div>
			<a href="#top">Nach oben ↑</a>
			<a href="mailto:hallo@lennartmahling.de">E-Mail</a>
		</div>
	</footer>
</Layout>
